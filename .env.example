# Shared secret that clients (e.g. the Fern mod) must send with every request.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEMETRY_TOKEN=replace-with-a-long-random-secret

# --- optional overrides (defaults shown) ---
# PORT=3000
# DATA_DIR=./data
# MAX_RECORDS=5000
