# --- shared secret (required) ---
# Clients (e.g. the Fern mod) and the sync tool must send this token with every request.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEMETRY_TOKEN=replace-with-your-own-secret

# --- local backup (sync.js) ---
# Your Railway server address:
SYNC_SERVER_URL=https://YOUR-APP.up.railway.app

# --- optional overrides (defaults shown) ---
# PORT=3000
# DATA_DIR=./data
# MAX_RECORDS=5000
